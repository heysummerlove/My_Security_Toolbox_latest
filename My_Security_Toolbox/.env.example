# API and login
MST_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
MST_DEFAULT_USERNAME=admin
MST_LOGIN_MAX_FAILURES=5
MST_LOGIN_LOCK_MINUTES=15

# Playwright browser cache
# Leave empty to use ./browser_bins automatically.
# PLAYWRIGHT_BROWSERS_PATH=E:\My_Security_Toolbox\My_Security_Toolbox\browser_bins

# Report template directories
# Multiple directories can be joined with ';' on Windows.
# The app will also try ./templates and ./data/template_extract automatically.
# MST_TEMPLATE_DIRS=E:\My_Security_Toolbox\My_Security_Toolbox\templates;E:\My_Security_Toolbox\My_Security_Toolbox\data\template_extract

# NSFOCUS automation
NSFOCUS_URL=https://192.168.193.10/
NSFOCUS_USERNAME=admin
NSFOCUS_PASSWORD=Nsfocus@123
NSFOCUS_HEADLESS=false
